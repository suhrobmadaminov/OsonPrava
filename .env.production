# ============================================
# OsonPrava - Railway Production Environment
# ============================================
# Bu faylni Railway Dashboard > Variables bo'limida qo'shing
# Yoki .env faylni Railway'ga upload qiling

# --------------------------------------------
# Django Security
# --------------------------------------------
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_USE_PYTHON_COMMAND_BELOW
DEBUG=False
ALLOWED_HOSTS=*.railway.app,osonprava-production.up.railway.app,localhost,127.0.0.1

# SECRET_KEY yaratish uchun Python command:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --------------------------------------------
# Database (Railway avtomatik qo'shadi)
# --------------------------------------------
# Railway'da PostgreSQL qo'shgandan keyin avtomatik paydo bo'ladi
# DATABASE_URL=postgresql://postgres:password@host:port/osonprava

# --------------------------------------------
# Redis (Upstash yoki Redis Cloud)
# --------------------------------------------
# Redis URL formati: redis://default:password@host:port
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@your-redis-host.upstash.io:6379

# Celery uchun (Redis bilan bir xil bo'lishi mumkin)
CELERY_BROKER_URL=redis://default:YOUR_REDIS_PASSWORD@your-redis-host.upstash.io:6379
CELERY_RESULT_BACKEND=redis://default:YOUR_REDIS_PASSWORD@your-redis-host.upstash.io:6379
CHANNELS_REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@your-redis-host.upstash.io:6379

# --------------------------------------------
# CORS (Frontend URL)
# --------------------------------------------
# Frontend hosting URL'ingizni qo'shing
CORS_ALLOWED_ORIGINS=https://web-production-5462b.up.railway.app,https://*.railway.app,http://localhost:3000,http://localhost:5173

# --------------------------------------------
# Telegram Bot
# --------------------------------------------
# @BotFather orqali yangi bot yarating
TELEGRAM_BOT_TOKEN=1234567890:YOUR_BOT_TOKEN
TELEGRAM_BOT_USERNAME=YourOsonPravaBot

# --------------------------------------------
# Email (Gmail SMTP) - Optional
# --------------------------------------------
# Agar email backend ishlatmasangiz, AUTO_VERIFY_EMAIL=True bo'ladi
# Gmail App Password yaratish: https://myaccount.google.com/apppasswords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# EMAIL_FROM=noreply@osonprava.uz

# Auto-verify email (True = email verification shart emas, darhol kirish mumkin)
AUTO_VERIFY_EMAIL=True

# Frontend URL (Email linklar uchun)
FRONTEND_URL=https://web-production-5462b.up.railway.app

# --------------------------------------------
# AWS S3 (Optional - Media files uchun)
# --------------------------------------------
# Agar S3 ishlatmoqchi bo'lsangiz:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=osonprava-media
# AWS_S3_REGION_NAME=eu-central-1

# --------------------------------------------
# Logging (Optional)
# --------------------------------------------
DJANGO_LOG_LEVEL=INFO
