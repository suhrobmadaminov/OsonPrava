# ============ RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES ============
# Copy this to .env and fill in the values from Railway dashboard
# Railway will automatically provide DATABASE_URL and REDIS_URL

# ============ DATABASE (Railway Postgres Plugin) ============
# Railway automatically sets DATABASE_URL when you add PostgreSQL service
# Example: DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# ============ REDIS (Railway Redis Plugin) ============
# Railway automatically sets REDIS_URL when you add Redis service
# Example: REDIS_URL=redis://default:password@redis.railway.internal:6379

# ============ JWT SECRETS ============
# Generate strong random secrets for production!
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============ TELEGRAM BOT ============
BOT_TOKEN=your-telegram-bot-token-here
BOT_API_KEY=your-bot-api-key-here
# Choose one: polling or webhook
BOT_MODE=polling
WEBHOOK_DOMAIN=your-bot-production-domain.railway.app
WEBHOOK_PATH=/bot/webhook
WEBHOOK_SECRET=your-webhook-secret
# Admin Telegram user IDs (comma-separated)
ADMIN_IDS=123456789

# ============ FILE STORAGE (S3/MinIO) ============
# Optional: If using S3 for file uploads
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_ENDPOINT=

# ============ EMAIL (Nodemailer) ============
# Optional: For email verification and notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@osonprava.uz

# ============ GENERAL ============
NODE_ENV=production
PORT=3001
API_URL=http://localhost:3001/api/v1

# ============ FRONTEND URL ============
# For CORS configuration
WEB_APP_URL=https://your-frontend-domain.railway.app
FRONTEND_URL=https://your-frontend-domain.railway.app

# ============ PAYMENT GATEWAYS ============
# Optional: For subscriptions
CLICK_PAYMENTS_MERCHANT_ID=
CLICK_PAYMENTS_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
